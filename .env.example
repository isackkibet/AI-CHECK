# ─────────────────────────────────────────────────────────────
# Brainstorm environment variables
# Template of server settings. Export the values in your shell before startup.
# ─────────────────────────────────────────────────────────────

# --- Server ---
PORT=3001
FRONTEND_URL=http://localhost:5173

# --- Database ---
# Path to the local SQLite file (default: data/brainstorm.db relative to server root)
BRAINSTORM_DB=data/brainstorm.db

# --- Claude Code session watcher ---
# Directory where Claude Code stores session JSONL logs
CLAUDE_LOGS_DIR=/path/to/your/.claude/projects
# Set to "false" to disable the real session watcher
WATCH_CLAUDE_SESSIONS=true

# --- Demo mode ---
# Set to "true" to generate fake sample events (useful for testing without Claude Code)
BRAINSTORM_DEMO=false

# --- AI features (optional — Brainstorm works fully offline without these) ---
# Anthropic API key for Claude-powered "why did you change this?" explanations
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model to use (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# --- Nemotron bulk processing (optional) ---
# NVIDIA API key for Nemotron 3 Nano batch file summarization
# Get yours at: https://build.nvidia.com/
NVIDIA_API_KEY=

# Nemotron model name (defaults to nvidia/llama-3.1-nemotron-nano-8b-v1)
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1

# Nemotron API base URL (defaults to NVIDIA's hosted endpoint; override for Brev GPU)
NEMOTRON_URL=https://integrate.api.nvidia.com/v1
